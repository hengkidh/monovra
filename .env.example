# Copy to .env (never commit .env) to build a signed release with `make release`.
# The keystore path is resolved inside the container (/workspace = repo root).
MONOVRA_KEYSTORE_FILE=/workspace/keys/monovra-release.jks
MONOVRA_KEYSTORE_PASSWORD=
MONOVRA_KEY_ALIAS=monovra
MONOVRA_KEY_PASSWORD=
MONOVRA_VERSION_NAME=0.1.0
MONOVRA_VERSION_CODE=1
